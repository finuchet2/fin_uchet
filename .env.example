DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/finzentra
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_USE_IMPORT_API=true

# Основной ИИ-провайдер: GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_MODEL=GigaChat

# Необязательный OpenAI-compatible fallback, если GIGACHAT_AUTH_KEY не задан
LLM_API_URL=
LLM_API_KEY=
